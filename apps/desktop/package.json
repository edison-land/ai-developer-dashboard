{
  "name": "@ai-dashboard/desktop",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "package:win": "pnpm --filter @ai-dashboard/ui build && pnpm build:main && electron-builder --win nsis --x64 --publish never",
    "start": "pnpm --filter @ai-dashboard/ui build && pnpm build:main && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-dashboard/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.aideveloperdashboard.desktop",
    "productName": "AI Developer Dashboard",
    "artifactName": "AI-Developer-Dashboard-v1.1.0-setup-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "../../dist/v1.1.0"
    },
    "files": [
      "dist/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/ui/dist",
        "to": "ui"
      }
    ],
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Developer Dashboard",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
